# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Scoped browser key for Google Maps Platform.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Cloud SQL (PostgreSQL) runtime & schema credentials (automatically injected by AI Studio)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="admin_password"
